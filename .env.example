APP_ENV=stage
# Use only [A-Za-z0-9] in POSTGRES_PASSWORD (it is embedded in a URL). Generate: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
# Docker Compose builds DATABASE_URL from POSTGRES_PASSWORD. Set it here only when running the app outside Compose.
# DATABASE_URL=postgresql+asyncpg://harness:CHANGE_DB_PASSWORD@127.0.0.1:5432/harness
JWT_SECRET=CHANGE_TO_LONG_RANDOM_SECRET
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD
DEFAULT_PROVIDER=auto
DEFAULT_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://ollama:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen3:8b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
ROUTER9_BASE_URL=http://host.docker.internal:20128/v1
ROUTER9_API_KEY=
ROUTER9_MODEL=
EMBED_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
SANDBOX_ROOT=/workspace
LOG_LEVEL=INFO
MAX_AGENT_STEPS=8
APPROVAL_REQUIRED_FOR_MUTATING_TOOLS=true
# Effect classes that need admin approval (READ, QUERY, WRITE, EXEC, DESTRUCTIVE)
APPROVAL_REQUIRED_EFFECTS=WRITE,DESTRUCTIVE
# Incident switch: false = local inference and embeddings only (no 9Router/OpenRouter)
CLOUD_PROVIDERS_ENABLED=true
# Comma-separated MCP hostnames; empty = any (stage only). Set before production.
MCP_ALLOWED_HOSTS=
MCP_TIMEOUT_SECONDS=30
TOOL_OUTPUT_MAX_CHARS=50000
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=1
